{
  "manifest_version": 3,
  "name": "讲座报名助手（公开版）",
  "version": "1.0.0",
  "description": "在腾讯文档讲座报名表中填写姓名、学号，按完整选项文字选择年级，支持仅填写或定时提交。",
  "permissions": ["storage"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "本页报名助手；非报名页显示使用指引"},
  "content_scripts": [{
    "matches": ["https://docs.qq.com/form/page/*"],
    "js": ["form.js", "assistant.js"],
    "run_at": "document_end"
  }]
}
